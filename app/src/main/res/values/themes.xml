<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BookProject" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >@color/background</item>
        <item name="android:windowLightStatusBar">false</item>



        <!-- Customize color of navigation drawer icon and back arrow -->
        <item name="colorControlNormal">@color/white</item>
        <item name="actionBarStyle">@style/ActionBar</item>
        <item name="buttonStyle">@style/MyGlobalButtonStyle</item>
        <item name="materialButtonStyle">@style/MyGlobalButtonStyle</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_arrow_left</item>

        <item name="android:windowFullscreen">false</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>
    <style name="CancelButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/square_stroke_btn</item>
        <item name="android:textColor">@color/orange_pacecount_color</item>
        <item name="android:inputType">textCapWords</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="SendlinkButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/rounded_btnborder</item>
        <item name="android:textColor">@color/orange_pacecount_color</item>
        <item name="android:inputType">textCapWords</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="NextButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/rounded_stroke_submit_btn</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@drawable/selector_button_text</item>
        <item name="android:inputType">textCapWords</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>
    <style name="ActionBar" parent="android:Theme.Holo">
        <item name="background">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="MyGlobalButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>

        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/semibold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item> </style>
    <style name="NewDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="dialogStyle" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>

    <style name="dialogStyleDropDown" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">40%</item>
        <item name="android:windowMinWidthMinor">40%</item>
    </style>

    <style name="MyCustomTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="dialogStyle2" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">96%</item>
        <item name="android:windowMinWidthMinor">96%</item>
    </style>

    <style name="Theme.BookProject.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rounded_corner</item>
    </style>

    <style name="Theme.BookProject.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.BookProject.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="inter_regular" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/regular</item>
        <item name="textAllCaps">false</item>
        <item name="color">@color/dawn_text_color</item>
    </style>

    <style name="inter_small_faint" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/regular</item>
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/dawn_text_color</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="inter_medium" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/medium</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="inter_semibold" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/semibold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="inter_bold" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout</item>
        <item name="shapeAppearance">@style/editTextBorder</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxBackgroundMode">filled</item>
        <item name="boxStrokeErrorColor">@color/error_500</item>
        <item name="placeholderTextAppearance">@style/PlaceholderTextSmall</item>
        <item name="placeholderTextColor">@color/neutral_300</item>
        <!--<item name="hintTextColor">?attr/colorOnSurface</item>-->
    </style>

    <style name="Widget.App.TextInputLayoutDropDown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.RoundedSmall</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeErrorColor">@color/error_500</item>
        <item name="expandedHintEnabled">false</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="boxBackgroundColor">@color/background</item>
        <item name="colorPrimary">#D4D4D8</item>
        <item name="android:longClickable">false</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="placeholderTextAppearance">@style/PlaceholderTextSmall</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
        <!--<item name="hintTextColor">?attr/colorOnSurface</item>-->
    </style>

    <style name="Widget.App.TextInputLayoutDropDown2" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/editTextBorder</item>
        <item name="boxStrokeErrorColor">@color/neutral_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">#D4D4D8</item>
        <item name="boxBackgroundColor">@color/background</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
        <!--<item name="hintTextColor">?attr/colorOnSurface</item>-->
    </style>

    <style name="Widget.App.TextInputLayout2" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/editTextBorder</item>
        <item name="boxStrokeErrorColor">@color/neutral_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="placeholderTextColor">@color/neutral_300</item>
        <item name="colorPrimary">#D4D4D8</item>
        <item name="boxBackgroundColor">@color/background</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
        <!--<item name="hintTextColor">?attr/colorOnSurface</item>-->
    </style>
    <style name="Widget.App.TextInputLayout3" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/editTextBorder</item>
        <item name="boxStrokeErrorColor">@color/neutral_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">#FFEB99</item>
        <item name="boxBackgroundColor">@color/background</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
        <!--<item name="hintTextColor">?attr/colorOnSurface</item>-->
    </style>



    <style name="Widget.App.TextInputLayoutDropDownDisable" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/editTextBorder</item>
        <item name="boxStrokeErrorColor">@color/neutral_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">#D4D4D8</item>
        <item name="placeholderTextColor">@color/neutral_300</item>
        <item name="android:longClickable">false</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="boxBackgroundColor">@color/disable</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
        <item name="boxStrokeColor">@color/light_grey3</item>
        <item name="android:textColor">@color/neutral_400</item>

        <!--<item name="hintTextColor">?attr/colorOnSurface</item>-->
    </style>

    <style name="Widget.App.TextInputLayoutDisable" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/editTextBorder</item>
        <item name="boxStrokeErrorColor">@color/neutral_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="placeholderTextColor">@color/neutral_300</item>
        <item name="colorPrimary">#D4D4D8</item>
        <item name="android:longClickable">false</item>
        <item name="boxBackgroundColor">@color/disable</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
        <item name="boxStrokeColor">@color/light_grey3</item>
        <item name="android:textColor">@color/neutral_400</item>

        <!--<item name="hintTextColor">?attr/colorOnSurface</item>-->
    </style>


    <style name="ThemeOverlay.App.TextInputLayout" parent="">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnSurface">@color/neutral_500</item>
        <item name="colorError">@color/error_500</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="colorSurface">@color/neutral_500</item>
        <!--Note: When setting a materialThemeOverlay on a custom TextInputLayout style, don’t forget to set editTextStyle to either a @style/Widget.MaterialComponents.TextInputEditText.* style or to a custom one that inherits from that.
        The TextInputLayout styles set materialThemeOverlay that overrides editTextStyle with the specific TextInputEditText style needed. Therefore, you don’t need to specify a style tag on the edit text.-->
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
    </style>

    <style name="ThemeOverlay.App.TextInputLayoutDropDown" parent="">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnSurface">@color/neutral_500</item>
        <item name="colorError">@color/error_500</item>
        <item name="hintTextAppearance">@style/hintTextAppearance</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="colorSurface">@color/neutral_500</item>
        <!--Note: When setting a materialThemeOverlay on a custom TextInputLayout style, don’t forget to set editTextStyle to either a @style/Widget.MaterialComponents.TextInputEditText.* style or to a custom one that inherits from that.
        The TextInputLayout styles set materialThemeOverlay that overrides editTextStyle with the specific TextInputEditText style needed. Therefore, you don’t need to specify a style tag on the edit text.-->
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox
        </item>
    </style>

    <style name="hintTextAppearance">
        <item name="fontFamily">@font/medium</item>
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textSize">12dp</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="editTextBorder" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="SpinnerTheme" parent="Widget.AppCompat.Spinner">
        <item name="spinnerStyle">@style/SpinnerStyle</item>
        <item name="android:spinnerStyle">@style/SpinnerStyle</item>
    </style>

    <style name="SpinnerStyle" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="drawableRightCompat">@drawable/ic_down_arrow</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.BookProject" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="checkedBox" parent="Base.Theme.AppCompat">
        <item name="colorAccent">#27568B</item> <!-- for checked state -->
        <item name="colorControlNormal">#626E78</item> <!-- for unchecked state -->
    </style>

    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/inter</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="PinWidget.PinView" parent="Widget.AppCompat.EditText">
        <item name="android:background">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:itemBackground">@drawable/checkbox_selector</item>
        <item name="android:textCursorDrawable">@drawable/pv_invisible_image</item>
        <item name="android:textSelectHandle">@drawable/pv_invisible_image</item>
        <item name="android:textSelectHandleLeft">@drawable/pv_invisible_image</item>
        <item name="android:textSelectHandleRight">@drawable/pv_invisible_image</item>
    </style>
    <style name="ShapeAppearance.App.RoundedSmall" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.App.RoundedCornerTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.RoundedSmall</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="expandedHintEnabled">false</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="boxStrokeErrorColor">@color/error_500</item>
        <item name="hintTextColor">@color/neutral_500</item>
        <item name="placeholderTextColor">@color/neutral_300</item>
        <item name="startIconTint">@color/orange</item>
        <item name="placeholderTextAppearance">@style/PlaceholderTextSmall</item>
    </style>

    <style name="AutoCompleteTextLayoutAppearance" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:layout_height">52dp</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:gravity">center</item>
        <item name="placeholderTextAppearance">@dimen/_14ssp</item>
    </style>


    <style name="textView12medium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/textview_primary</item>
    </style>

    <style name="TextInputPrefix.Centered" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>

        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/neutral_main</item>
    </style>
</resources>